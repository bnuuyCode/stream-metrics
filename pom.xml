<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- The version of the POM format itself, not of this project.
         It has been 4.0.0 for twenty years. Always this value. -->
    <modelVersion>4.0.0</modelVersion>

    <!-- ===================================================================
         IDENTITY

         These three lines are this project's address in the Maven world.
         Any other project could depend on us using exactly these
         coordinates, the same way we depend on Javalin further down.

         groupId    who owns it. Convention is a reverse domain name. With no
                    domain of my own, io.github.<username> is the accepted
                    convention for personal projects.
         artifactId the project's own name.
         version    -SNAPSHOT means "still in development, may change without
                    warning". When something is released for real, the suffix
                    is dropped: 1.0.0.
         =================================================================== -->
    <groupId>io.github.bnuuycode</groupId>
    <artifactId>stream-metrics</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>stream-metrics</name>
    <description>Local social media metrics aggregator: every platform on one screen.</description>

    <!-- ===================================================================
         PROPERTIES

         Variables. Every version number lives here rather than being
         scattered through the file, so upgrading a library means editing one
         line in one place instead of hunting for it.

         Referenced below as ${javalin.version}.
         =================================================================== -->
    <properties>
        <!-- Which Java version to compile for. "release" is stricter than the
             older source/target pair: it also checks that no API newer than 17
             is used by accident. -->
        <maven.compiler.release>17</maven.compiler.release>

        <!-- MANDATORY ON WINDOWS. Without this line Maven uses the operating
             system's default encoding, which on Windows is not UTF-8, and
             accented characters in source files or in the SQL migration get
             mangled at build time. -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Library versions. If IntelliJ underlines one of these in red, the
             version does not exist; hover over it and the IDE will suggest the
             nearest real one. -->
        <javalin.version>6.3.0</javalin.version>
        <jackson.version>2.17.2</jackson.version>
        <jdbi.version>3.45.4</jdbi.version>
        <sqlite.version>3.46.1.0</sqlite.version>
        <flyway.version>9.22.3</flyway.version>
        <logback.version>1.5.6</logback.version>
        <junit.version>5.10.3</junit.version>

        <!-- Plugin versions. Pinning these matters: without an explicit
             version Maven picks whatever it feels like, and the build stops
             being reproducible across machines. -->
        <compiler.plugin.version>3.13.0</compiler.plugin.version>
        <surefire.plugin.version>3.2.5</surefire.plugin.version>
        <shade.plugin.version>3.5.3</shade.plugin.version>
    </properties>

    <dependencies>

        <!-- ===============================================================
             WEB — Javalin

             The HTTP server. Also serves the front-end static files, so
             there is no second server to run.

             Javalin pulls Jetty in on its own, and Jetty pulls in its own
             dependencies. None of that is listed here: Maven walks the
             whole tree and downloads it. That is the entire point of it.
             =============================================================== -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>${javalin.version}</version>
        </dependency>

        <!-- Logging implementation.
             Javalin logs through slf4j, which is only an interface — it needs
             an actual implementation behind it or the app starts with a
             warning and prints nothing useful. Logback is that implementation.
             Leave it out and the first real error will be invisible. -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <!-- ===============================================================
             JSON — Jackson

             Converts Java objects into JSON responses, and the JSON that
             comes back from Twitch into Java objects.
             =============================================================== -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Java date/time support for Jackson.
             This one is not optional here. Without it, Jackson serializes an
             Instant as an unreadable pile of numbers instead of
             "2026-08-27T14:32:11Z" — and every API response in this project
             carries a fetchedAt timestamp (see DECISIONS.md § 3). -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- ===============================================================
             DATABASE
             =============================================================== -->

        <!-- The SQLite driver. This is what actually knows how to read and
             write the .db file. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <!-- JDBI: a thin layer over JDBC. Turns query results into objects
             without becoming an ORM. The SQL stays written by hand and
             visible (DECISIONS.md § 1). -->
        <dependency>
            <groupId>org.jdbi</groupId>
            <artifactId>jdbi3-core</artifactId>
            <version>${jdbi.version}</version>
        </dependency>

        <!-- The SqlObject extension: lets a DAO be declared as an interface
             with the SQL in an annotation, instead of writing the same
             boilerplate for every query. -->
        <dependency>
            <groupId>org.jdbi</groupId>
            <artifactId>jdbi3-sqlobject</artifactId>
            <version>${jdbi.version}</version>
        </dependency>

        <!-- Flyway: runs the migrations in src/main/resources/db/migration
             on startup, in filename order, recording what has already been
             applied so nothing runs twice.

             Deliberately pinned to the 9.x line: Flyway 10 split database
             support into separate modules and would need a second dependency
             here. 9.22.3 is monolithic, supports SQLite out of the box, and
             is more than enough for this project. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>${flyway.version}</version>
        </dependency>

        <!-- ===============================================================
             TESTS

             scope=test means: available while running tests, and NOT shipped
             inside the final jar. JUnit has no business being in production.
             =============================================================== -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <!-- The name of the generated file, without the version suffix.
             Produces target/stream-metrics.jar rather than
             target/stream-metrics-0.1.0-SNAPSHOT.jar, which makes the startup
             script simpler. -->
        <finalName>stream-metrics</finalName>

        <plugins>

            <!-- Compiles the Java source. Reads maven.compiler.release from
                 the properties block above. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.plugin.version}</version>
            </plugin>

            <!-- Runs the tests during the build. Required for JUnit 5:
                 old versions of surefire silently find no tests at all and
                 report success, which is the worst possible failure mode. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.plugin.version}</version>
            </plugin>

            <!-- Shade: bundles the application AND every dependency into a
                 single executable jar. Without it, running the app means
                 assembling a classpath with thirty jars by hand.

                 With it:  java -jar target/stream-metrics.jar

                 The manifest transformer writes the entry point into the jar
                 so that "java -jar" knows which class to start. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${shade.plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.github.bnuuycode.streammetrics.Main</mainClass>
                                </transformer>
                                <!-- Merges the META-INF/services files from all
                                     dependencies instead of letting the last one
                                     overwrite the rest. Skip this and the SQLite
                                     driver can silently vanish from the fat jar. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <!-- Strips the signature files of signed dependencies.
                                 Left in place, Java refuses to start the jar with
                                 a SecurityException. -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
